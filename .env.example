# Required
GEMINI_API_KEY=your-gemini-api-key

# Recommended current Gemini model; change if your account uses another model.
GEMINI_MODEL=gemini-3.8-flash

# FastAPI URL used by the Agent Host when running in remote mode.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Streamlit -> FastAPI URL.
# Leave blank for Streamlit in-process MCP mode.
API_BASE_URL=http://127.0.0.1:8000

# Agent safety / loop bound
MAX_AGENT_STEPS=6

# CORS for local development. Restrict in production.
ALLOWED_ORIGINS=*
